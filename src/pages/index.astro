---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stripe from '../components/Stripe.astro';
import { tripDays } from '../data/trip';

const countries = (await getCollection('countries')).sort(
  (a, b) => a.data.start.getTime() - b.data.start.getTime(),
);
const photoCount = countries.reduce((n, c) => n + c.data.photos.length, 0);
---

<Base title="Around Asia">
  <main>
    <section class="placeholder">
      <h1>Follow our journey</h1>
      <p>Around Asia: the site is being rebuilt.</p>
      <p class="stats">
        {tripDays} days · {countries.length} countries · {photoCount} photos
      </p>
    </section>
    <Stripe arrow>
      <h2>Destinations</h2>
    </Stripe>
    <ul class="cards">
      {countries.map((c) => (
        <li>
          <Image src={c.data.card} alt="" width={240} />
          <span>{c.data.name}</span>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .placeholder {
    display: grid;
    place-content: center;
    gap: 0.5rem;
    min-block-size: 60dvh;
    padding: calc(var(--header-height) + 2rem) 2rem 2rem;
    text-align: center;
    background: var(--color-blue);
    color: var(--color-white);
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--step-h1);
    font-weight: 400;
  }

  p {
    color: var(--color-yellow);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 1rem;
  }
</style>
