---
/**
 * The photostream: a masonry-like grid of thumbnails, each a plain link to the full image
 * (works without JS; the lightbox enhances these links later).
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/gallery.css';

export type GalleryItem =
  | { kind: 'public'; image: ImageMetadata; alt: string; caption?: string }
  | { kind: 'private'; url: string; width: number; height: number; alt: string; caption?: string };

interface Props {
  items: GalleryItem[];
  label: string;
}
const { items, label } = Astro.props;

const sizes = '(width >= 1200px) 20vw, (width >= 768px) 25vw, 33vw';

const resolved = await Promise.all(
  items.map(async (item) => {
    if (item.kind === 'private') {
      return { ...item, full: item.url };
    }
    // Full-size target for the link / lightbox: same pixels, modern format.
    const full = await getImage({ src: item.image, format: 'webp', quality: 85 });
    return { ...item, full: full.src, width: item.image.width, height: item.image.height };
  }),
);
---

<ul class="gallery" aria-label={label}>
  {resolved.map((item) => (
    <li>
      <a
        href={item.full}
        data-pswp-width={item.width}
        data-pswp-height={item.height}
        style={`aspect-ratio: ${item.width} / ${item.height}`}
      >
        {item.kind === 'public' ? (
          <Picture
            src={item.image}
            alt={item.alt}
            formats={['avif', 'webp']}
            widths={[240, 360, 480, 720]}
            sizes={sizes}
            loading="lazy"
          />
        ) : (
          <img
            src={item.url}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
          />
        )}
      </a>
      {item.caption && <p class="gallery__caption">{item.caption}</p>}
    </li>
  ))}
</ul>
