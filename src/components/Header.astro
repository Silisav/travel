---
import '../styles/header.css';
import Logo from '../icons/travel.svg';
import SiteNav from './SiteNav.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">
      <Logo aria-hidden="true" />
      <span class="visually-hidden">Travel: back to the homepage</span>
    </a>
    <button
      type="button"
      class="nav-button"
      command="show-modal"
      commandfor="site-nav"
      aria-haspopup="dialog"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-button__icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<SiteNav />
