---
import Watch from '../icons/watch.svg';

interface Props {
  timeZone: string;
  label: string;
}
const { timeZone, label } = Astro.props;
---

<!-- Hidden until the script fills it in: without JS there's no sensible time to show. -->
<p class="hero__corner local-clock" hidden>
  <Watch aria-hidden="true" />
  <span class="visually-hidden">Local time in {label}:</span>
  <time data-tz={timeZone}></time>
</p>

<script>
  const clocks = [...document.querySelectorAll<HTMLTimeElement>('time[data-tz]')];

  function tick() {
    const now = new Date();
    for (const clock of clocks) {
      const timeZone = clock.dataset.tz;
      clock.textContent = new Intl.DateTimeFormat('en-GB', { timeStyle: 'short', timeZone }).format(
        now,
      );
      clock.dateTime = now.toISOString();
      clock.closest('[hidden]')?.removeAttribute('hidden');
    }
  }

  tick();
  // Re-sync on the minute boundary, then every minute.
  setTimeout(
    () => {
      tick();
      setInterval(tick, 60_000);
    },
    60_000 - (Date.now() % 60_000),
  );
</script>
